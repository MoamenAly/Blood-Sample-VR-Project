  originalText: "\u064A\u062C\u0628 \u062E\u0644\u0637 \u0627\u0644\u0623\u0646\u0627\u0628\u064A\u0628
    \u0628\u0644\u0637\u0641 \u0628\u0639\u062F \u0627\u0644\u0633\u062D\u0628 \u0645\u0628\u0627\u0634\u0631\u0629\u060C
    \u0639\u0646 \u0637\u0631\u064A\u0642 \u0627\u0644\u0625\u0645\u0627\u0644\u0629
    \u0639\u062F\u0629 \u0645\u0631\u0627\u062A (\u0648\u0644\u064A\u0633 \u0627\u0644\u0631\u062C\u0651
