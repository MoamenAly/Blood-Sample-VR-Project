  originalText: "\u062A\u064F\u062F\u062E\u0644 \u0627\u0644\u0625\u0628\u0631\u0629
    \u0628\u0632\u0627\u0648\u064A\u0629 \u062A\u062A\u0631\u0627\u0648\u062D \u0628\u064A\u0646
    15\u201330\xB0\u060C \u0644\u0636\u0645\u0627\u0646 \u062A\u0645\u0627\u0633
    \u0645\u0646\u0627\u0633\u0628 \u0645\u0639 \u0627\u0644\u0639\u0636\u0644\u0629.\n\u0627\u0644\u0644\u0648\u0646
    \u0627\u0644\u0623\u062D\u0645\u0631 \u064A\u064F\u0633\u062A\u062E\u062F\u0645
    \u0643\u0645\u0624\u0634\u0631 \u0639\u0644\u0649 \u0627\u0644\u0648\u0635\u0648\u0644
    \u0625\u0644\u0649 \u0627\u0644\u0639\u0645\u0642 \u0627\u0644\u0635\u062D\u064A\u062D.\n\n\u0638\u0647\u0648\u0631
    \u0627\u0631\u062A\u062F\u0627\u062F \u062F\u0645 \u0628\u0633\u064A\u0637 (Flashback)
    \u064A\u064F\u0639\u062F \u062A\u0623\u0643\u064A\u062F\u064B\u0627 \u0639\u0644\u0649
    \u0623\u0646 \u0627\u0644\u0625\u0628\u0631\u0629 \u0641\u064A \u0645\u0648\u0636\u0639\u0647\u0627
    \u062F\u0627\u062E\u0644 \u0627\u0644\u0648\u0631\u064A\u062F"
