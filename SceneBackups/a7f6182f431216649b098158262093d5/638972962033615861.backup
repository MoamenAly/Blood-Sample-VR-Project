    \u0627\u0644\u062C\u064A\u062F \u0623\u0648 \u0627\u0644\u062E\u0644\u0637 \u0627\u0644\u0639\u0646\u064A\u0641
    \u0642\u062F \u064A\u0624\u062F\u064A \u0625\u0644\u0649 \u062A\u062C\u0644\u0637
    \u0627\u0644\u0639\u064A\u0646\u0629 \u0628\u0633\u0628\u0628 \u0646\u0642\u0635
    \u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u062A\u0648\u0632\u064A\u0639
    \n\u0627\u0644\u0645\u0627\u062F\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629
    \u062F\u0627\u062E\u0644 \u0627\u0644\u0623\u0646\u0628\u0648\u0628."
