  originalText: "\u062A\u0645\u064A\u064A\u0632 \u0627\u0644\u0623\u0648\u0631\u062F\u0629
    \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0637\u0628\u0642\u0629 AR:\r\n\u0627\u0644\u0623\u062E\u0636\u0631 
    = \u0627\u0644\u0648\u0631\u064A\u062F \u0627\u0644\u0645\u0631\u0641\u0642\u064A
    \u0627\u0644\u0623\u0648\u0633\u0637 (Median Cubital Vein)\r\n\u0627\u0644\u0623\u0635\u0641\u0631
    = \u0627\u0644\u0648\u0631\u064A\u062F \u0627\u0644\u0643\u0639\u0628\u0631\u064A
    (Cephalic Vein)\r\n\u0627\u0644\u0628\u0631\u062A\u0642\u0627\u0644\u064A = \u0627\u0644\u0648\u0631\u064A\u062F
    \u0627\u0644\u0648\u0631\u064A\u062F\u064A \u0627\u0644\u062F\u0627\u062E\u0644\u064A
    (Basilic Vein)\r\n\r\n\u0623\u0628\u062F\u0623 \u062F\u0627\u0626\u0645\u064B\u0627
    \u0628\u0627\u0644\u0648\u0631\u064A\u062F \u0627\u0644\u0623\u0648\u0633\u0637\u060C
    \u0641\u0647\u0648 \u0627\u0644\u0623\u0643\u062B\u0631 \u062B\u0628\u0627\u062A\u064B\u0627
    \u0648\u062A\u062F\u0641\u0642\u064B\u0627 \u0644\u0644\u062F\u0645"
  fixTags: 1
  forceFix: 0
