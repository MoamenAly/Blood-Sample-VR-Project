  originalText: "\u064A\u062A\u0645 \u062A\u062D\u062F\u064A\u062F \u0642\u0637\u0631
    \u0627\u0644\u0648\u0631\u064A\u062F \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
