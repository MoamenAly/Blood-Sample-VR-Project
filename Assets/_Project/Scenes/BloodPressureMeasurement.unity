  steps:
  - isCurrent: 0
    id: Doctor Dialog1
    subtitle: "Doctor: Good morning, I\u2019m the neurologist today. Could you tell
      me your name and what brings you here?"
    typewriterMode: 2
    syncToNarration: 0
    wordsPerSecond: 4
    lettersPerSecond: 20
    narration: {fileID: 8300000, guid: 06d15905c33d58f46ba66d1a082375e1, type: 3}
    autoNextOnNarrationEnd: 1
    autoNextDelay: 2
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onNarrationFinished:
      m_PersistentCalls:
        m_Calls: []
  - isCurrent: 0
    id: Patient Dialog1
    subtitle: "Patient: Good morning, doctor. I\u2019m Dalia, 26 years old, a schoolteacher.
      For the past few weeks, I\u2019ve been waking up with a dull headache at the
      back of my head, along with nausea and blurred vision that sometimes turns
      into double vision. I\u2019ve also been a bit forgetful and irritable, and
      my family says I look pale, tired, and occasionally confused."
    typewriterMode: 2
    syncToNarration: 0
    wordsPerSecond: 4
    lettersPerSecond: 20
    narration: {fileID: 8300000, guid: 1655ff9eea43fd640a401f8eefd8a788, type: 3}
    autoNextOnNarrationEnd: 1
    autoNextDelay: 2
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onNarrationFinished:
      m_PersistentCalls:
        m_Calls: []
  - isCurrent: 0
    id: Doctor Dialog2
    subtitle: "Doctor: Thank you. I\u2019ll examine you now."
    typewriterMode: 2
    syncToNarration: 0
    wordsPerSecond: 4
    lettersPerSecond: 20
    narration: {fileID: 8300000, guid: 5de19ad4568d7d848b0e00c9fce35cf8, type: 3}
    autoNextOnNarrationEnd: 1
    autoNextDelay: 2
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onNarrationFinished:
      m_PersistentCalls:
        m_Calls: []
  - isCurrent: 0
    id: Patient Dialog2
    subtitle: "Patient: Okay, let\u2019s go."
    typewriterMode: 2
    syncToNarration: 0
    wordsPerSecond: 4
    lettersPerSecond: 20
    narration: {fileID: 8300000, guid: 0fb1719c8123c104295242c5a5f98d3e, type: 3}
